# The CLI reads environment variables, not .env automatically.
# Docker Compose reads this file after you copy it to .env.
EVOMESH_MODEL=your-tool-capable-model
EVOMESH_BASE_URL=https://your-provider.example/v1
EVOMESH_API_KEY=
EVOMESH_PROJECT=personal
EVOMESH_OWNER=personal
EVOMESH_SERVER_TOKEN=replace-with-a-long-random-token
# Compose passwords: use URL-safe values (or percent-encode the database URL).
MYSQL_PASSWORD=replace-with-a-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password
